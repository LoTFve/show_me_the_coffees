{
  "name": "lucky-agent",
  "version": "0.1.0",
  "description": "瑞幸点单助手 MCP：偏好记忆 + 下单二次确认，基于瑞幸官方 MCP",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc && npm run bundle",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=bundle/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --log-level=warning",
    "co-diagram": "node scripts/co-diagram.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "bin": {
    "lucky-agent": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
